# Copy this file to .env for a new installation. Merge into an existing .env.
# Never commit actual credentials.
GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional role-specific model overrides; providers remain fixed.
ANALYST_MODEL=gemini-3.5-flash-lite
RESEARCHER_MODEL=qwen/qwen3.8-27b
REVIEWER_MODEL=openai/gpt-oss-120b

# Conservative researcher input estimate + output reserve per request.
# Raise only after verifying your hosted account's real allowance.
RESEARCHER_TOKEN_BUDGET=1000
# Optional historical discovery via GitHub code search (requires GITHUB_TOKEN).
ENABLE_VCDB=0

GITHUB_TOKEN=
PORT=8765
